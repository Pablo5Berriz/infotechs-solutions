# Public site URL used for canonical metadata and deployment checks.
NEXT_PUBLIC_SITE_URL=https://infotechssolutions.ca

# Contact email to display publicly once confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional public phone to display once confirmed.
NEXT_PUBLIC_CONTACT_PHONE=

# Server-only Resend configuration for contact request delivery.
RESEND_API_KEY=
CONTACT_FORM_FROM=
CONTACT_FORM_TO=

# Enable only when the application is unreachable except through a controlled
# proxy that strips client-supplied IP headers and rewrites X-Infotechs-Client-IP.
CONTACT_TRUSTED_PROXY_MODE=off

# Local integration tests only; omit in production to use https://api.resend.com/emails.
CONTACT_PROVIDER_API_URL=
